{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve Snooze App",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/server.js"],
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Listening on http://localhost:8000/",
          "endsPattern": "^.*(?=Keyboard interrupt|shut down).*"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run Snooze App",
      "dependsOn": ["Serve Snooze App"],
      "problemMatcher": [],
      "group": {
        "kind": "build"
      }
    }
  ]
}
